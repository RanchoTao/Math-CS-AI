{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranchotao.com/Math-CS-AI/schemas/course-implementation.schema.json",
  "title": "课程实现",
  "type": "object",
  "required": ["schemaVersion", "id", "knowledgeNode", "institution", "courseCode", "title", "academicYear", "language", "officialUrl", "status", "coverage", "features", "workload", "dimensions", "resources", "sources", "verification"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "knowledgeNode": { "type": "string", "minLength": 1 },
    "institution": { "type": "string", "minLength": 1 },
    "courseCode": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "academicYear": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "officialUrl": { "type": ["string", "null"], "format": "uri" },
    "status": { "enum": ["active", "historical", "unknown"] },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "level"],
        "properties": { "topic": { "type": "string", "minLength": 1 }, "level": { "enum": ["intro", "core", "advanced"] } },
        "additionalProperties": false
      }
    },
    "features": { "type": "array", "items": { "enum": ["labs", "projects", "paper-reading", "proof-heavy", "systems-programming"] }, "uniqueItems": true },
    "workload": {
      "type": "object",
      "required": ["estimatedHours"],
      "properties": {
        "estimatedHours": {
          "type": ["object", "null"],
          "required": ["min", "max"],
          "properties": { "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "required": ["theoryDepth", "practiceIntensity", "mathRequirement", "programmingIntensity", "resourceCompleteness"],
      "properties": {
        "theoryDepth": { "type": "integer", "minimum": 1, "maximum": 5 },
        "practiceIntensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "mathRequirement": { "type": "integer", "minimum": 1, "maximum": 5 },
        "programmingIntensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "resourceCompleteness": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "verification": { "enum": ["draft", "validated", "reviewed"] }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["title", "url"],
      "properties": { "title": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
