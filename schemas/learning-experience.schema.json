{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranchotao.com/Math-CS-AI/schemas/learning-experience.schema.json",
  "title": "学习经验",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "knowledgeNode",
    "sourceType",
    "hardestParts",
    "mostValuableParts",
    "recommendedPreparation",
    "advice",
    "source",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "knowledgeNode": { "type": "string", "minLength": 1 },
    "courseImplementation": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sourceType": { "enum": ["community-project", "maintainer-review", "learner-report"] },
    "workloadHours": { "type": ["integer", "null"], "minimum": 0 },
    "difficulty": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "hardestParts": { "type": "array", "items": { "type": "string" } },
    "mostValuableParts": { "type": "array", "items": { "type": "string" } },
    "recommendedPreparation": { "type": "array", "items": { "type": "string" } },
    "advice": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      },
      "additionalProperties": false
    },
    "verification": { "enum": ["unverified", "reviewed"] }
  },
  "additionalProperties": false
}
